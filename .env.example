# Address of the deployed PactPay escrow on NEAR testnet.
VITE_NEAR_ESCROW=
VITE_NEAR_ESCROW_V2=
PACTPAY_NEAR_ESCROW_V2=
# Public RPC only. Vite exposes this value to the browser.
VITE_NEAR_RPC=https://test.rpc.fastnear.com

# Public Auth0 client ID for the NEAR Auth testnet tenant. Enable only after
# its administrator has allowed the deployed callback and origin.
VITE_NEAR_AUTH_TESTNET_CLIENT_ID=
# Optional public Auth0 hostname for a dedicated client, without https:// or a path.
VITE_NEAR_AUTH_TESTNET_DOMAIN=
